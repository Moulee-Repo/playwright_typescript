{
  "compilerOptions": {
    "target": "ESNext",
    "module": "node16",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "@playwright/test"],
    "outDir": "dist"
  },
  "include": [
    "specs/**/*.ts",
    "playwright.native.config.ts",
    "playwright.bdd.config.ts",
    "playwright.browserstack.config.ts",
    "playwright.browserstack.bdd.config.ts",
    "fixtures.ts",
    "utilities/**/*.ts"
  ]
}