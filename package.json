{
  "name": "playwright_typescript",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:bddjs": "cucumber-js -c cucumber.cjs",
    "test:bdd": "npx bddgen --config=playwright.bdd.config.ts && npx playwright test --config=playwright.bdd.config.ts",
    "test:native": "npx playwright test --config=playwright.native.config.ts ",
    "test:all": "npm run test:bdd && npm run test:native",
    "test:docker": "npm run test:all",
    "test:browserstack": "npm run test:browserstack:bdd && npm run test:browserstack:native",
    "test:browserstack:bdd": "npx bddgen --config=playwright.browserstack.bdd.config.ts && npx playwright test --config=playwright.browserstack.bdd.config.ts",
    "test:browserstack:native": "npx playwright test --config=playwright.browserstack.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.1.2",
    "dotenv": "^18.0.9",
    "playwright-bdd": "^9.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
